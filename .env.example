# ---------------------------------------------------------------------------
# Zero-cost defaults. Copy to .env and add one free API key to get running.
#
#   Groq          https://console.groq.com/keys        (default - fast, tools)
#   NVIDIA NIM    https://build.nvidia.com             (fallback)
#   GitHub Models https://github.com/marketplace/models
#
# Groq, NVIDIA NIM, GitHub Models and Ollama are ALL OpenAI-compatible, so one
# provider class covers every option - only base_url and model change.
# ---------------------------------------------------------------------------

GROQ_API_KEY=
LLM_PROVIDER=groq
# Groq rotates its catalogue; check https://api.groq.com/openai/v1/models if a
# model id 404s. Verified working with tool calls: openai/gpt-oss-120b,
# openai/gpt-oss-20b, qwen/qwen3.8-27b.
LLM_MODEL=openai/gpt-oss-120b

# Optional fallback, used when the primary trips its circuit breaker.
LLM_FALLBACK_PROVIDER=
NVIDIA_API_KEY=

# Fully local instead:  docker compose --profile local up
#   LLM_PROVIDER=ollama
#   LLM_MODEL=qwen2.5:7b-instruct
#   qwen2.5 is the most reliable small model for tool calling. Most others
#   silently fail to emit tool calls and will cost you half a day.

# LiveKit - dev credentials, matching infra/livekit.yaml
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret-local-only-not-for-production
LIVEKIT_PUBLIC_URL=ws://localhost:7880

# Tracing. Unset means a no-op exporter; tracing is never a hard dependency.
#   docker compose --profile obs up    then open http://localhost:6006
# OTEL_EXPORTER_OTLP_ENDPOINT=http://phoenix:6006/v1/traces
